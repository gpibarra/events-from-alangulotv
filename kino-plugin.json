{
  "id": "events-from-alangulotv",
  "name": "Eventos de AlAnguloTV",
  "version": "0.5.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Eventos deportivos en vivo de la agenda de alangulotv",
  "hosts": [
    "alangulotv.sx",
    "*.alangulotv.sx",
    "spf24live.st",
    "*.spf24live.st",
    "latamzy.com",
    "*.latamzy.com",
    "sudamericafy.com",
    "*.sudamericafy.com"
  ],
  "capabilities": [
    "home",
    "resolve",
    "channels"
  ],
  "browser": true,
  "streamHosts": "any",
  "categories": [
    "live"
  ],
  "discoverable": false,
  "color": "#FFB020",
  "icon": "icon.png",
  "settings": [
    {
      "key": "tz",
      "label": "Zona horaria",
      "type": "select",
      "default": "-3",
      "options": [
        {
          "value": "-9",
          "label": "UTC-9"
        },
        {
          "value": "-8",
          "label": "UTC-8"
        },
        {
          "value": "-7",
          "label": "UTC-7"
        },
        {
          "value": "-6",
          "label": "UTC-6 · México, Centroamérica"
        },
        {
          "value": "-5",
          "label": "UTC-5 · Colombia, Perú, Ecuador"
        },
        {
          "value": "-4",
          "label": "UTC-4 · Venezuela, Bolivia, Chile"
        },
        {
          "value": "-3",
          "label": "UTC-3 · Argentina, Uruguay, Brasil"
        },
        {
          "value": "-2",
          "label": "UTC-2"
        },
        {
          "value": "-1",
          "label": "UTC-1"
        },
        {
          "value": "0",
          "label": "UTC+0"
        },
        {
          "value": "1",
          "label": "UTC+1 · hora de la agenda"
        },
        {
          "value": "2",
          "label": "UTC+2"
        },
        {
          "value": "3",
          "label": "UTC+3"
        }
      ],
      "hint": "Zona en que se muestran las horas (la agenda viene en UTC+1)."
    },
    {
      "key": "actualizar",
      "label": "Actualizar eventos ahora",
      "type": "action",
      "hint": "Lee la agenda y fuerza a Kino a pedirla de nuevo."
    },
    {
      "key": "forzar",
      "label": "Forzar actualización de eventos",
      "type": "toggle",
      "hint": "Lo usa el botón de arriba y se apaga solo. No hace falta tocarlo."
    }
  ]
}
